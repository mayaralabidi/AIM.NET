@model aim.Helpers.PaginatedList<aim.Models.Participant>
@{
    ViewData["Title"] = "Global Leaderboard";
    string tab = ViewBag.Tab ?? "alltime";
    int currentId = (int)(ViewBag.CurrentId ?? 0);
    int startRank = (Model.PageIndex - 1) * 25 + 1;
}

<div class="gl-wrap">
    <div class="gl-header">
        <div class="gl-title">Global <span>Leaderboard</span></div>
    </div>

    <div class="tab-row">
        <a asp-action="Leaderboard" asp-route-tab="alltime"
           class="tab-btn @(tab == "alltime" ? "active" : "")">All time</a>
        <a asp-action="Leaderboard" asp-route-tab="monthly"
           class="tab-btn @(tab == "monthly" ? "active" : "")">This month</a>
        <a asp-action="Leaderboard" asp-route-tab="weekly"
           class="tab-btn @(tab == "weekly" ? "active" : "")">This week</a>
    </div>

    <div class="gl-table">
        @if (!Model.Any())
        {
            <div class="empty-state" style="padding:40px">
                <div class="empty-text">No activity yet for this period</div>
            </div>
        }
        else
        {
            int rank = startRank;
            foreach (var p in Model)
            {
                bool isYou = p.Id == currentId;
                var initials = string.Concat(p.Name.Split(' ').Take(2).Select(w => w[0])).ToUpper();
                <div class="gl-row @(isYou ? "gl-you" : "")">
                    <div class="gl-rank">
                        @if (rank == 1)
                        {
                            <span>🥇</span>
                        }
                        else if (rank == 2)
                        {

                            <span>🥈</span>
                        }
                        else if (rank == 3)
                        {

                            <span>🥉</span>
                        }
                        else
                        {

                            <span style="color:var(--mu)">@rank</span>
                        }
                    </div>
                    <div class="gl-avatar">@initials</div>
                    <div class="gl-info">
                        <div class="gl-name">
                            @p.Name
                            @if (isYou)
                            {
                                <span class="you-tag">you</span>
                            }
                        </div>
                        <div class="gl-meta">
                            🔥 @p.CurrentStreak day streak
                            @if (p.BestStreak > 0)
                            {
                                <span>· Best @p.BestStreak</span>
                            }
                        </div>
                    </div>
                    <div class="gl-score">
                        <div class="gl-score-val">@p.TotalScore.ToString("N0")</div>
                        <div class="gl-score-lbl">pts</div>
                    </div>
                </div>
                rank++;
            }
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="pagination">
            @if (Model.HasPrev)
            {
                <a asp-action="Leaderboard" asp-route-tab="@tab"
                   asp-route-page="@(Model.PageIndex - 1)" class="pg-btn">← Prev</a>
            }
            <span class="pg-info">@Model.PageIndex / @Model.TotalPages</span>
            @if (Model.HasNext)
            {
                <a asp-action="Leaderboard" asp-route-tab="@tab"
                   asp-route-page="@(Model.PageIndex + 1)" class="pg-btn">Next →</a>
            }
        </div>
    }
</div>

<style>
    .gl-wrap {
        max-width: 680px;
        margin: 0 auto;
        padding: 28px 20px 80px;
    }

    .gl-header {
        margin-bottom: 20px;
    }

    .gl-title {
        font-family: 'Barlow Condensed',sans-serif;
        font-size: 36px;
        font-weight: 700;
        color: var(--tx);
    }

        .gl-title span {
            color: var(--o);
        }

    .tab-row {
        display: flex;
        gap: 6px;
        margin-bottom: 20px;
    }

    .tab-btn {
        background: var(--cd);
        border: 0.5px solid var(--br);
        color: var(--mu);
        border-radius: 8px;
        padding: 7px 16px;
        font-size: 13px;
        text-decoration: none;
        transition: all .15s;
    }

        .tab-btn.active {
            background: var(--o);
            color: #111110;
            border-color: var(--o);
            font-weight: 500;
        }

        .tab-btn:hover:not(.active) {
            color: var(--tx);
            border-color: rgba(255,255,255,.2);
        }

    .gl-table {
        background: var(--cd);
        border: 0.5px solid var(--br);
        border-radius: 14px;
        overflow: hidden;
    }

    .gl-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 18px;
        border-bottom: 0.5px solid var(--br);
        transition: background .15s;
    }

        .gl-row:last-child {
            border-bottom: none;
        }

        .gl-row:hover {
            background: rgba(255,255,255,.02);
        }

    .gl-you {
        background: rgba(239,159,39,.05);
        border-left: 2px solid var(--o);
    }

    .gl-rank {
        width: 28px;
        text-align: center;
        font-size: 16px;
        flex-shrink: 0;
    }

    .gl-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: rgba(239,159,39,.12);
        color: var(--o);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .gl-info {
        flex: 1;
    }

    .gl-name {
        font-size: 14px;
        font-weight: 500;
        color: var(--tx);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .gl-meta {
        font-size: 11px;
        color: var(--mu);
        margin-top: 2px;
    }

    .you-tag {
        font-size: 10px;
        background: rgba(239,159,39,.15);
        color: var(--o);
        border-radius: 999px;
        padding: 2px 7px;
    }

    .gl-score {
        text-align: right;
        flex-shrink: 0;
    }

    .gl-score-val {
        font-family: 'Barlow Condensed',sans-serif;
        font-size: 20px;
        font-weight: 700;
        color: var(--tx);
        line-height: 1;
    }

    .gl-score-lbl {
        font-size: 10px;
        color: var(--mu);
    }
</style>