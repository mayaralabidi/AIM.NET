@model aim.Models.Participant
@{
    ViewData["Title"] = "Activity";
    var heatmap = ViewBag.HeatmapData as Dictionary<DateTime, int> ?? new();
    var yearStart = (DateTime)ViewBag.YearStart;
    var weeklyAvgs = ViewBag.WeeklyAverages as dynamic;
    int maxCount = heatmap.Any() ? heatmap.Values.Max() : 1;
}

<div class="act-wrap">

    <div class="act-header">
        <div>
            <div class="act-title">Activity</div>
            <div class="act-sub">Last 52 weeks</div>
        </div>
    </div>

    @* ── Stats row ── *@
    <div class="act-stats">
        <div class="act-stat">
            <strong data-counter data-target="@ViewBag.AllCompletions">@ViewBag.AllCompletions</strong>
            All time
        </div>
        <div class="act-stat">
            <strong data-counter data-target="@ViewBag.ThisMonth">@ViewBag.ThisMonth</strong>
            This month
        </div>
        <div class="act-stat">
            <strong data-counter data-target="@ViewBag.ThisWeek">@ViewBag.ThisWeek</strong>
            This week
        </div>
        <div class="act-stat">
            <strong>@ViewBag.AvgPerWeek</strong>
            Avg / week
        </div>
        <div class="act-stat">
            <strong>@ViewBag.BestDayCount</strong>
            Best day
            @if (ViewBag.BestDay != null)
            {
                <div class="act-stat-sub">@((DateTime)ViewBag.BestDay).ToString("MMM d")</div>
            }
        </div>
        <div class="act-stat">
            <strong style="color:var(--t)">@Model.CurrentStreak</strong>
            Current streak
        </div>
        <div class="act-stat">
            <strong style="color:var(--p)">@Model.BestStreak</strong>
            Best streak
        </div>
    </div>

    @* ── Heatmap ── *@
    <div class="section-label">Contribution heatmap</div>
    <div class="heatmap-scroll">
        <div class="heatmap-grid" id="heatmap"></div>
    </div>
    <div class="heatmap-legend">
        <span>Less</span>
        <div class="legend-cell" style="background:var(--hm0)"></div>
        <div class="legend-cell" style="background:var(--hm1)"></div>
        <div class="legend-cell" style="background:var(--hm2)"></div>
        <div class="legend-cell" style="background:var(--hm3)"></div>
        <div class="legend-cell" style="background:var(--hm4)"></div>
        <span>More</span>
    </div>

    @* ── Weekly bar chart ── *@
    <div class="section-label" style="margin-top:32px">Weekly tasks (last 12 weeks)</div>
    <div class="bar-chart">
        @{
            var avgs = ViewBag.WeeklyAverages as IEnumerable<dynamic> ?? new List<dynamic>();
            var maxBar = 1;
            foreach (var w in avgs) if ((int)w.Count > maxBar) maxBar = (int)w.Count;
        }
        @foreach (var w in avgs)
        {
            int pct = maxBar == 0 ? 0 : (int)Math.Round((double)w.Count / maxBar * 100);
            <div class="bar-col">
                <div class="bar-val">@w.Count</div>
                <div class="bar-track">
                    <div class="bar-fill" style="height:@pct%"></div>
                </div>
                <div class="bar-label">@w.Label</div>
            </div>
        }
    </div>

</div>

@* Heatmap data passed to JS *@
<script>
    const heatmapData = {
        @foreach (var kvp in heatmap)
        {
                <text>'@kvp.Key.ToString("yyyy-MM-dd")': @kvp.Value,</text>
        }
    };
    const yearStart  = new Date('@yearStart.ToString("yyyy-MM-dd")');
    const maxCount   = @maxCount;

    function getColor(count) {
        if (count === 0) return 'var(--hm0)';
        if (count === 1) return 'var(--hm1)';
        if (count <= 3)  return 'var(--hm2)';
        if (count <= 6)  return 'var(--hm3)';
        return 'var(--hm4)';
    }

    const grid = document.getElementById('heatmap');
    const today = new Date();
    today.setHours(0,0,0,0);

    // Build 52 weeks × 7 days
    for (let week = 0; week < 53; week++) {
        const col = document.createElement('div');
        col.className = 'hm-col';

        for (let day = 0; day < 7; day++) {
            const d = new Date(yearStart);
            d.setDate(d.getDate() + week * 7 + day);
            if (d > today) { col.appendChild(document.createElement('div')); continue; }

            const key   = d.toISOString().slice(0, 10);
            const count = heatmapData[key] || 0;
            const cell  = document.createElement('div');
            cell.className = 'hm-cell';
            cell.style.background = getColor(count);
            cell.title = `${key}: ${count} task${count !== 1 ? 's' : ''}`;
            col.appendChild(cell);
        }
        grid.appendChild(col);
    }
</script>

<style>
    :root {
        --hm0: rgba(255,255,255,0.05);
        --hm1: rgba(29,158,117,0.25);
        --hm2: rgba(29,158,117,0.45);
        --hm3: rgba(29,158,117,0.70);
        --hm4: #1D9E75;
    }

    .act-wrap {
        max-width: 960px;
        margin: 0 auto;
        padding: 28px 20px 80px;
    }

    .act-header {
        margin-bottom: 24px;
    }

    .act-title {
        font-family: 'Barlow Condensed',sans-serif;
        font-size: 36px;
        font-weight: 700;
        color: var(--tx);
    }

    .act-sub {
        font-size: 13px;
        color: var(--mu);
        margin-top: 4px;
    }

    .act-stats {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 32px;
    }

    .act-stat {
        background: var(--cd);
        border: 0.5px solid var(--br);
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 12px;
        color: var(--mu);
        flex: 1;
        min-width: 100px;
    }

        .act-stat strong {
            display: block;
            font-family: 'Barlow Condensed',sans-serif;
            font-size: 24px;
            font-weight: 700;
            color: var(--tx);
            line-height: 1;
            margin-bottom: 3px;
        }

    .act-stat-sub {
        font-size: 10px;
        color: var(--o);
        margin-top: 2px;
    }

    .section-label {
        font-family: 'Barlow Condensed',sans-serif;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--mu);
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .section-label::after {
            content: '';
            flex: 1;
            height: 0.5px;
            background: var(--br);
        }

    /* Heatmap */
    .heatmap-scroll {
        overflow-x: auto;
        padding-bottom: 8px;
    }

    .heatmap-grid {
        display: flex;
        gap: 3px;
        width: max-content;
    }

    .hm-col {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .hm-cell {
        width: 12px;
        height: 12px;
        border-radius: 2px;
        cursor: default;
        transition: opacity .15s;
    }

        .hm-cell:hover {
            opacity: .75;
        }

    .heatmap-legend {
        display: flex;
        align-items: center;
        gap: 4px;
        margin-top: 8px;
        font-size: 11px;
        color: var(--mu);
    }

    .legend-cell {
        width: 12px;
        height: 12px;
        border-radius: 2px;
    }

    /* Bar chart */
    .bar-chart {
        display: flex;
        align-items: flex-end;
        gap: 6px;
        height: 120px;
        padding-bottom: 24px;
        position: relative;
    }

    .bar-col {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 1;
        height: 100%;
        justify-content: flex-end;
    }

    .bar-val {
        font-size: 10px;
        color: var(--mu);
        margin-bottom: 3px;
    }

    .bar-track {
        flex: 1;
        width: 100%;
        background: rgba(255,255,255,0.05);
        border-radius: 4px 4px 0 0;
        display: flex;
        align-items: flex-end;
    }

    .bar-fill {
        width: 100%;
        background: var(--p);
        border-radius: 4px 4px 0 0;
        transition: height .6s ease;
        min-height: 2px;
    }

    .bar-label {
        font-size: 9px;
        color: var(--mu);
        margin-top: 4px;
        white-space: nowrap;
        transform: rotate(-45deg);
        transform-origin: top left;
        position: absolute;
        bottom: 0;
    }

    @@media (max-width:600px) {
        .hm-cell {
            width: 9px;
            height: 9px;
        }

        .act-stats {
            gap: 8px;
        }

        .act-stat {
            min-width: 80px;
        }
    }
</style>