@{
    ViewData["Title"] = "New Goal";
}

<div class="pg-wrap">
    <a asp-action="Index" class="back-link">← Goals</a>
    <div class="pg-title" style="margin:16px 0 28px">New <span style="color:var(--o)">Goal</span></div>

    @if (ViewBag.Error != null)
    {
        <div class="form-error">@ViewBag.Error</div>
    }

    <form method="post" asp-action="Create" class="goal-form">
        @Html.AntiForgeryToken()

        <div class="field">
            <label>What's your goal?</label>
            <input type="text" name="description" placeholder="e.g. Complete 50 tasks" required />
        </div>
        <div class="field">
            <label>Target value</label>
            <input type="number" name="targetValue" placeholder="e.g. 50" min="1" required />
        </div>
        <div class="field">
            <label>Target date</label>
            <input type="date" name="targetDate" required
                   min="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="btn-new" style="width:100%;justify-content:center">Create Goal</button>
    </form>
</div>

<style>
    .pg-wrap {
        max-width: 480px;
        margin: 0 auto;
        padding: 28px 20px 80px;
    }

    .pg-title {
        font-family: 'Barlow Condensed',sans-serif;
        font-size: 36px;
        font-weight: 700;
        color: var(--tx);
    }

    .back-link {
        font-size: 12px;
        color: var(--mu);
        transition: color .15s;
    }

        .back-link:hover {
            color: var(--tx);
        }

    .form-error {
        background: rgba(226,75,74,.12);
        border: 0.5px solid rgba(226,75,74,.3);
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 13px;
        color: var(--r);
        margin-bottom: 16px;
    }

    .field {
        margin-bottom: 16px;
    }

    label {
        display: block;
        font-size: 12px;
        color: var(--mu);
        margin-bottom: 6px;
    }

    input[type=text], input[type=number], input[type=date] {
        width: 100%;
        background: var(--cd);
        border: 0.5px solid var(--br);
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 14px;
        color: var(--tx);
        font-family: 'DM Sans',sans-serif;
        outline: none;
        transition: border-color .15s;
    }

    input:focus {
        border-color: var(--o);
    }

    .btn-new {
        background: var(--o);
        color: #111110;
        border: none;
        border-radius: 8px;
        padding: 11px 16px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        display: flex;
        transition: opacity .15s;
    }

        .btn-new:hover {
            opacity: .85;
        }
</style>