@model aim.Models.Participant
@{
    ViewData["Title"] = "Daily Check-in";
    var todayCheckIn = ViewBag.TodayCheckIn as aim.Models.DailyCheckIn;
    var last30 = ViewBag.Last30 as List<aim.Models.DailyCheckIn> ?? new();
    var tasksByDay = ViewBag.TasksByDay as Dictionary<DateTime, int> ?? new();
    bool checkedIn = todayCheckIn != null;

    string[] moodEmoji = { "", "😫", "😕", "😐", "😊", "🔥" };
    string[] energyEmoji = { "", "💀", "😴", "⚡", "💪", "🚀" };
}

<div class="ci-wrap">
    <div class="ci-title">Daily <span>Check-in</span></div>

    @* Today's check-in form *@
    <div class="ci-card">
        <div class="ci-card-title">
            @if (checkedIn)
            {
                <text>Today's check-in ✓</text>
            }
            else
            {

                <text>How are you feeling today?</text>
            }
        </div>

        <form method="post" asp-action="Submit">
            @Html.AntiForgeryToken()

            <div class="ci-section">
                <div class="ci-label">Mood</div>
                <div class="emoji-row" id="moodRow">
                    @for (int i = 1; i <= 5; i++)
                    {
                        bool selected = checkedIn && (int)todayCheckIn!.Mood == i;
                        <label class="emoji-btn @(selected ? "selected" : "")">
                            <input type="radio" name="mood" value="@i"
                                   @(selected ? "checked" : "") required />
                            <span>@moodEmoji[i]</span>
                        </label>
                    }
                </div>
            </div>

            <div class="ci-section">
                <div class="ci-label">Energy</div>
                <div class="emoji-row" id="energyRow">
                    @for (int i = 1; i <= 5; i++)
                    {
                        bool selected = checkedIn && (int)todayCheckIn!.Energy == i;
                        <label class="emoji-btn @(selected ? "selected" : "")">
                            <input type="radio" name="energy" value="@i"
                                   @(selected ? "checked" : "") required />
                            <span>@energyEmoji[i]</span>
                        </label>
                    }
                </div>
            </div>

            <div class="ci-section">
                <div class="ci-label">Note (optional)</div>
                <textarea name="note" placeholder="How's the day going..."
                          rows="2" maxlength="200" class="ci-textarea">@todayCheckIn?.Note</textarea>
            </div>

            <button type="submit" class="ci-submit">
                @(checkedIn ? "Update check-in" : "Submit check-in")
            </button>
        </form>
    </div>

    @* History *@
    @if (last30.Any())
    {
        <div class="section-label" style="margin-top:32px">Last 30 days</div>
        <div class="ci-history">
            @foreach (var c in last30)
            {
                int tasks = tasksByDay.GetValueOrDefault(c.Date.Date, 0);
                <div class="ci-history-item">
                    <div class="ci-date">@c.Date.ToString("MMM d")</div>
                    <div class="ci-emojis">
                        @moodEmoji[(int)c.Mood]
                        @energyEmoji[(int)c.Energy]
                    </div>
                    <div class="ci-tasks-count">@tasks task@(tasks != 1 ? "s" : "")</div>
                    @if (!string.IsNullOrEmpty(c.Note))
                    {
                        <div class="ci-note">@c.Note</div>
                    }
                </div>
            }
        </div>
    }
</div>

<script>
    document.querySelectorAll('.emoji-row').forEach(row => {
        row.querySelectorAll('label').forEach(label => {
            label.addEventListener('click', () => {
                row.querySelectorAll('label').forEach(l => l.classList.remove('selected'));
                label.classList.add('selected');
            });
        });
    });
</script>

<style>
    .ci-wrap {
        max-width: 580px;
        margin: 0 auto;
        padding: 28px 20px 80px;
    }

    .ci-title {
        font-family: 'Barlow Condensed',sans-serif;
        font-size: 36px;
        font-weight: 700;
        color: var(--tx);
        margin-bottom: 24px;
    }

        .ci-title span {
            color: var(--o);
        }

    .ci-card {
        background: var(--cd);
        border: 0.5px solid var(--br);
        border-radius: 14px;
        padding: 22px;
    }

    .ci-card-title {
        font-size: 15px;
        font-weight: 500;
        color: var(--tx);
        margin-bottom: 20px;
    }

    .ci-section {
        margin-bottom: 18px;
    }

    .ci-label {
        font-size: 12px;
        color: var(--mu);
        margin-bottom: 10px;
    }

    .emoji-row {
        display: flex;
        gap: 10px;
    }

    .emoji-btn {
        cursor: pointer;
    }

        .emoji-btn input {
            display: none;
        }

        .emoji-btn span {
            font-size: 28px;
            display: block;
            padding: 6px;
            border-radius: 10px;
            border: 2px solid transparent;
            transition: all .15s;
        }

        .emoji-btn:hover span {
            background: rgba(255,255,255,.05);
        }

        .emoji-btn.selected span {
            border-color: var(--o);
            background: rgba(239,159,39,.1);
        }

    .ci-textarea {
        width: 100%;
        background: rgba(255,255,255,.05);
        border: 0.5px solid var(--br);
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 13px;
        color: var(--tx);
        font-family: 'DM Sans',sans-serif;
        outline: none;
        resize: none;
        transition: border-color .15s;
    }

        .ci-textarea:focus {
            border-color: var(--o);
        }

    .ci-submit {
        width: 100%;
        background: var(--o);
        color: #111110;
        border: none;
        border-radius: 8px;
        padding: 11px;
        font-size: 14px;
        font-weight: 500;
        font-family: 'DM Sans',sans-serif;
        cursor: pointer;
        margin-top: 4px;
        transition: opacity .15s;
    }

        .ci-submit:hover {
            opacity: .88;
        }

    .section-label {
        font-family: 'Barlow Condensed',sans-serif;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--mu);
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .section-label::after {
            content: '';
            flex: 1;
            height: 0.5px;
            background: var(--br);
        }

    .ci-history {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .ci-history-item {
        background: var(--cd);
        border: 0.5px solid var(--br);
        border-radius: 10px;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .ci-date {
        font-size: 12px;
        color: var(--mu);
        min-width: 48px;
    }

    .ci-emojis {
        font-size: 18px;
        flex-shrink: 0;
    }

    .ci-tasks-count {
        font-size: 12px;
        color: var(--mu);
        flex-shrink: 0;
    }

    .ci-note {
        font-size: 12px;
        color: var(--mu);
        flex: 1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-style: italic;
    }
</style>