<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — AIM</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="aim-nav">
        <a asp-controller="Home" asp-action="Index" class="aim-logo">
            A<span>I</span>M
        </a>
        <div class="aim-nav-links">
            <a asp-controller="Challenges" asp-action="Index" class="nav-link">Challenges</a>
            <a asp-controller="Teams" asp-action="Index" class="nav-link">Teams</a>
            <a asp-controller="Participants" asp-action="Dashboard" class="nav-link">Dashboard</a>
            <a asp-controller="Participants" asp-action="Badges" class="nav-link">Badges</a>
            <a asp-controller="PersonalGoals" asp-action="Index" class="nav-link">Goals</a>
            <a asp-controller="Participants" asp-action="Activity" class="nav-link">Activity</a>
            <a asp-controller="Notifications" asp-action="Feed" class="nav-link nav-bell">
                🔔
                @if ((int)(ViewBag.UnreadNotifications ?? 0) > 0)
                {
                    <span class="bell-dot">@ViewBag.UnreadNotifications</span>
                }
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Participants" asp-action="Profile" class="nav-user">
                    @User.Identity.Name
                </a>
            }
        </div>
        <div class="aim-nav-right">

            @* Search form in navbar *@
            <form method="get" asp-action="Index" asp-controller="Search" class="nav-search">
                <input type="text" name="q" placeholder="Search..." class="nav-search-input" />
            </form>

            @* New nav links *@
            <a asp-controller="Follows" asp-action="Feed" class="nav-link">Feed</a>
            <a asp-controller="Participants" asp-action="Leaderboard" class="nav-link">Rankings</a>
            <a asp-controller="CheckIn" asp-action="Index" class="nav-link">Check-in</a>

            @* Freeze token pill — only show if user has one *@
            @if ((int)(ViewBag.FreezeTokens ?? 0) > 0)
            {
                <div class="freeze-pill" title="Streak freeze token — auto-activates if you miss a day">
                    🧊 <span>1</span>
                </div>
            }
            @* Streak pill *@
            <div class="streak-pill">
                <span class="flame">🔥</span>
                <span id="nav-streak">—</span>
            </div>
            @* Score pill *@
            <div class="score-pill">
                <span id="nav-score">—</span>
                <span class="pts-label">pts</span>
            </div>
            @* Logout *@
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form method="post" asp-action="Logout" asp-controller="Auth" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-logout">Sign out</button>
                </form>
            }
            @* Mobile menu toggle *@
            <button class="menu-toggle" onclick="toggleMenu()" aria-label="Menu">
                <span></span><span></span><span></span>
            </button>
        </div>
    </nav>

    @* Mobile dropdown *@
    <div class="mobile-menu" id="mobileMenu">
        <a asp-controller="Challenges" asp-action="Index" class="mob-link">Challenges</a>
        <a asp-controller="Teams" asp-action="Index" class="mob-link">Teams</a>
        <a asp-controller="Participants" asp-action="Dashboard" class="mob-link">Dashboard</a>
        <a asp-controller="Participants" asp-action="Badges" class="mob-link">Badges</a>
        <a asp-controller="PersonalGoals" asp-action="Index" class="mob-link">Goals</a>
        <a asp-controller="Participants" asp-action="Activity" class="mob-link">Activity</a>
        <a asp-controller="Notifications" asp-action="Feed" class="mob-link">🔔 Notifications</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post" asp-action="Logout" asp-controller="Auth">
                @Html.AntiForgeryToken()
                <button type="submit" class="mob-link mob-logout">Sign out</button>
            </form>
        }
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Participants" asp-action="Profile" class="nav-user">
                @User.Identity.Name
            </a>
        }
    </div>

    <main>
        @RenderBody()
    </main>

    @await Html.PartialAsync("_Toast")
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/aim.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>