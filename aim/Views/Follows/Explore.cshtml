@model List<aim.Models.Participant>
@{
    ViewData["Title"] = "Explore";
    var followingIds = ViewBag.FollowingIds as List<int> ?? new();
    int currentId = (int)(ViewBag.CurrentId ?? 0);
}

<div class="ex-wrap">
    <div class="ex-header">
        <div class="ex-title">Explore <span>Users</span></div>
        <a asp-action="Feed" class="btn-cta">My feed</a>
    </div>

    <form method="get" asp-action="Explore" class="search-form">
        <input type="text" name="search" value="@ViewBag.Search"
               placeholder="Search by name..." class="search-input" autocomplete="off" />
        <button type="submit" class="search-btn">Search</button>
    </form>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="ti ti-users"></i></div>
            <div class="empty-text">No users found</div>
            <div class="empty-sub">Try a different search</div>
        </div>
    }
    else
    {
        <div class="user-grid">
            @foreach (var u in Model)
            {
                bool isFollowing = followingIds.Contains(u.Id);
                var initials = string.Concat(u.Name.Split(' ').Take(2).Select(w => w[0])).ToUpper();
                <div class="user-card">
                    <div class="user-avatar">@initials</div>
                    <div class="user-info">
                        <div class="user-name">@u.Name</div>
                        <div class="user-meta">
                            <span>🔥 @u.CurrentStreak</span>
                            <span>@u.TotalScore pts</span>
                        </div>
                    </div>
                    <form method="post" asp-action="Toggle"
                          asp-route-returnUrl="@Context.Request.Path">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="targetId" value="@u.Id" />
                        <button type="submit" class="@(isFollowing ? "btn-unfollow" : "btn-follow")">
                            @(isFollowing ? "Following" : "Follow")
                        </button>
                    </form>
                </div>
            }
        </div>
    }
</div>

<style>
    .ex-wrap {
        max-width: 680px;
        margin: 0 auto;
        padding: 28px 20px 80px;
    }

    .ex-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .ex-title {
        font-family: 'Barlow Condensed',sans-serif;
        font-size: 36px;
        font-weight: 700;
        color: var(--tx);
    }

        .ex-title span {
            color: var(--o);
        }

    .search-form {
        display: flex;
        gap: 8px;
        margin-bottom: 24px;
    }

    .search-input {
        flex: 1;
        background: var(--cd);
        border: 0.5px solid var(--br);
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 14px;
        color: var(--tx);
        font-family: 'DM Sans',sans-serif;
        outline: none;
        transition: border-color .15s;
    }

        .search-input:focus {
            border-color: var(--o);
        }

    .search-btn {
        background: var(--o);
        color: #111110;
        border: none;
        border-radius: 8px;
        padding: 10px 18px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        font-family: 'DM Sans',sans-serif;
    }

    .user-grid {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .user-card {
        background: var(--cd);
        border: 0.5px solid var(--br);
        border-radius: 12px;
        padding: 14px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: border-color .2s;
    }

        .user-card:hover {
            border-color: rgba(255,255,255,.15);
        }

    .user-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(239,159,39,.15);
        color: var(--o);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .user-info {
        flex: 1;
    }

    .user-name {
        font-size: 14px;
        font-weight: 500;
        color: var(--tx);
    }

    .user-meta {
        font-size: 12px;
        color: var(--mu);
        margin-top: 3px;
        display: flex;
        gap: 12px;
    }

    .btn-follow {
        background: var(--o);
        color: #111110;
        border: none;
        border-radius: 7px;
        padding: 7px 16px;
        font-size: 12px;
        font-weight: 500;
        cursor: pointer;
        font-family: 'DM Sans',sans-serif;
        transition: opacity .15s;
    }

        .btn-follow:hover {
            opacity: .85;
        }

    .btn-unfollow {
        background: transparent;
        border: 0.5px solid var(--br);
        color: var(--mu);
        border-radius: 7px;
        padding: 7px 16px;
        font-size: 12px;
        cursor: pointer;
        font-family: 'DM Sans',sans-serif;
        transition: border-color .15s;
    }

        .btn-unfollow:hover {
            border-color: var(--r);
            color: var(--r);
        }
</style>